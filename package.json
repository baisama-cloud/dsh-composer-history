{
  "name": "dsh-composer-history",
  "description": "Command history for the DeepSeek Harness web GUI composer: press Up/Down to cycle through your previously sent instructions, and reach the oldest draft again at the end of the history. 在 DSH Web 输入框中用上下方向键浏览此前发送的指令，回到历史末尾时恢复切换前的草稿。",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "composer",
    "history",
    "arrow-keys",
    "command-line",
    "web-ui"
  ]
}
